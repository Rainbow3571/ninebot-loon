#!name = 九号出行自动签到
#!desc = 九号出行自动签到 v4。抓Token开关默认关闭(不弹通知), 需要重抓时手动打开; 每日签到显示连续天数/N币/余额并自动开惊喜盲盒。⚠️ 使用前请生成并信任CA证书。
#!author = WorkBuddy
#!tag = 签到

[Argument]
capture = switch,false,tag=抓取Token开关,desc=仅在需要重新抓取Token时打开; 抓完请关闭, 平时关闭不会弹任何通知

[Script]
# 抓取 Token: 仅在开关打开时生效; 抓不到凭证的请求静默跳过
http-request ^https?:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/user-sign\/v2\/(sign|status) script-path=https://cdn.jsdelivr.net/gh/Rainbow3571/ninebot-loon@cb9d90877bdf71421ee442f613693617bd952337/Scripts/ninebot.token.js, argument=[{capture}], tag=九号Token获取, enable=true

# 每日签到: 连续天数 + 今日N币 + N币余额 + 自动开惊喜盲盒
cron "30 8 * * *" script-path=https://cdn.jsdelivr.net/gh/Rainbow3571/ninebot-loon@cb9d90877bdf71421ee442f613693617bd952337/Scripts/ninebot.checkin.js, tag=九号出行签到, timeout=120, enable=true

[MITM]
hostname = cn-cbu-gateway.ninebot.com
