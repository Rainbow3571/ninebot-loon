#!name = 九号出行自动签到
#!desc = 九号出行每日自动签到。使用方法: 开启插件后打开九号APP签到页面, 自动抓取Token; 之后每天定时自动签到。⚠️ 使用前请在 Loon 设置中生成并信任CA证书。
#!author = WorkBuddy
#!tag = 签到

[Script]
# 抓取 Token: 打开九号APP签到页面时触发, 保存 Authorization 与 device_id
http-request ^https?:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/user-sign\/v2\/(sign|status) script-path=https://cdn.jsdelivr.net/gh/Rainbow3571/ninebot-loon@main/Scripts/ninebot.token.js, tag=九号Token获取, enable=true

# 每日签到任务: 每天 08:30 执行, 可自行修改时间
cron "30 8 * * *" script-path=https://cdn.jsdelivr.net/gh/Rainbow3571/ninebot-loon@main/Scripts/ninebot.checkin.js, tag=九号出行签到, enable=true

# 手动脚本: 查看已抓取的 Token (Loon → 脚本 → 手动脚本)
generic script-path=https://cdn.jsdelivr.net/gh/Rainbow3571/ninebot-loon@main/Scripts/ninebot.view.js, tag=九号Token查看, enable=true

[MITM]
hostname = cn-cbu-gateway.ninebot.com
